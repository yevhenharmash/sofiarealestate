{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash",
      "Bash(gh pr *)",
      "Bash(npx tsc *)",
      "Bash(pnpm audit *)",
      "Bash(xargs ls *)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "Bash(pnpm --filter editor-frontend exec tsc --noEmit)",
      "Bash(npx jest *)",
      "Bash(npx turbo *)",
      "Skill(code-review)",
      "Skill(code-review:*)",
      "Bash(npx eslint *)",
      "Bash(pnpm --filter @kiroku-code/kiroku-api-types run gen:gql)",
      "Skill(claude-api)",
      "Skill(claude-api:*)",
      "Bash(pnpm run *)",
      "Bash(pnpm test *)",
      "Bash(pnpm exec *)",
      "Bash(npm install *)"
    ],
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)"
    ],
    "defaultMode": "acceptEdits"
  }
}
